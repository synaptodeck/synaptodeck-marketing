---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<header
  class:list={[
    'flex flex-col gap-4',
    align === 'center' ? 'items-center text-center' : 'items-start text-left',
  ]}
>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2 class="heading-2 text-ink-50">{title}</h2>
  {description && <p class:list={['lead', align === 'center' && 'max-w-2xl']}>{description}</p>}
</header>
