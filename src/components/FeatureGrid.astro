---
import FeatureCard from './FeatureCard.astro';
import type { Feature } from '../lib/features';

interface Props {
  features: Feature[];
  columns?: 2 | 3 | 4;
  compact?: boolean;
}

const { features, columns = 3, compact = false } = Astro.props;

const columnClass = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-2 lg:grid-cols-3',
  4: 'md:grid-cols-2 lg:grid-cols-4',
}[columns];
---

<div class:list={['grid gap-5', columnClass]}>
  {features.map((feature) => <FeatureCard feature={feature} compact={compact} />)}
</div>
