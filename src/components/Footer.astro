---
import { Icon } from 'astro-icon/components';

const cols = [
  {
    heading: 'Product',
    links: [
      { href: '/features', label: 'Features' },
      { href: '/ai-builder', label: 'AI Builder' },
      { href: '/mobile-remote', label: 'Mobile Remote' },
      { href: '/download', label: 'Download' },
      { href: '/pricing', label: 'Pricing' },
    ],
  },
  {
    heading: 'Compare',
    links: [
      { href: '/vs/stream-deck', label: 'vs Stream Deck' },
      { href: '/vs/raycast', label: 'vs Raycast' },
    ],
  },
  {
    heading: 'Resources',
    links: [
      { href: '/changelog', label: 'Changelog' },
      { href: '/security', label: 'Security & privacy' },
      { href: '/feedback', label: 'Feedback' },
    ],
  },
  {
    heading: 'Project',
    links: [
      { href: 'https://github.com/synaptodeck/synaptodeck', label: 'GitHub' },
      { href: 'https://github.com/synaptodeck/synaptodeck/issues', label: 'Issues' },
      { href: 'https://github.com/synaptodeck/synaptodeck/blob/main/BACKLOG.md', label: 'Roadmap' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 bg-ink-950">
  <div class="container-page py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-2.5 text-ink-50 hover:text-brand-cyan" aria-label="SynaptoDeck home">
          <img src="/brand/logo-mark.svg" alt="" width="28" height="28" class="h-7 w-7" />
          <span class="text-base font-semibold tracking-tightish">SynaptoDeck</span>
        </a>
        <p class="mt-4 max-w-sm text-sm text-ink-300">
          A programmable button grid for your desktop and phone. Local-first. Free for personal use.
        </p>
        <div class="mt-5 flex items-center gap-2">
          <a
            href="https://github.com/synaptodeck/synaptodeck"
            rel="noopener"
            aria-label="GitHub"
            class="inline-flex h-9 w-9 items-center justify-center rounded-md text-ink-300 hover:bg-white/5 hover:text-ink-50"
          >
            <Icon name="lucide:github" class="h-4 w-4" />
          </a>
        </div>
      </div>

      {
        cols.map((col) => (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-400">{col.heading}</h3>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    rel={link.href.startsWith('http') ? 'noopener' : undefined}
                    class="text-sm text-ink-200 hover:text-brand-cyan"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col justify-between gap-4 border-t border-white/5 pt-6 text-xs text-ink-400 md:flex-row md:items-center">
      <p>&copy; {year} SynaptoDeck. Local-first. Free for personal use.</p>
      <p>Built with Astro on Cloudflare Pages.</p>
    </div>
  </div>
</footer>
