---
import { Icon } from 'astro-icon/components';

interface Props {
  eyebrow?: string;
  headline: string;
  subheadline: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  screenshotSrc?: string;
  screenshotAlt?: string;
}

const {
  eyebrow,
  headline,
  subheadline,
  primaryCta = { href: '/download', label: 'Download for free' },
  secondaryCta = { href: '/features', label: 'See what it does' },
  screenshotSrc = '/screenshots/hero-placeholder.svg',
  screenshotAlt = 'A SynaptoDeck profile on a dark theme with buttons for Spotify, GitHub, Slack, a terminal, and a calendar widget.',
} = Astro.props;
---

<section class="relative overflow-hidden bg-hero-grid">
  <div class="container-page relative grid gap-12 py-20 md:py-28 lg:grid-cols-12 lg:gap-10 lg:py-32">
    <div class="lg:col-span-7">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1 class="heading-1 mt-4 max-w-3xl text-ink-50">{headline}</h1>
      <p class="lead mt-6 max-w-2xl">{subheadline}</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={primaryCta.href} class="btn-primary text-base">
          <Icon name="lucide:download" class="h-4 w-4" />
          <span>{primaryCta.label}</span>
        </a>
        <a href={secondaryCta.href} class="btn-secondary text-base">
          <span>{secondaryCta.label}</span>
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </div>
      <ul class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-ink-300">
        <li class="flex items-center gap-1.5">
          <Icon name="lucide:check" class="h-4 w-4 text-brand-cyan" />
          <span>Windows + macOS</span>
        </li>
        <li class="flex items-center gap-1.5">
          <Icon name="lucide:check" class="h-4 w-4 text-brand-cyan" />
          <span>Local-first, no account</span>
        </li>
        <li class="flex items-center gap-1.5">
          <Icon name="lucide:check" class="h-4 w-4 text-brand-cyan" />
          <span>Free for personal use</span>
        </li>
      </ul>
    </div>

    <div class="lg:col-span-5">
      <div class="relative rounded-2xl bg-card-glow p-1.5 shadow-glow ring-1 ring-white/10">
        <div class="overflow-hidden rounded-xl bg-ink-900">
          <img
            src={screenshotSrc}
            alt={screenshotAlt}
            width="1200"
            height="900"
            loading="eager"
            decoding="async"
            class="block aspect-[4/3] w-full object-cover"
          />
        </div>
      </div>
      <p class="mt-3 text-xs text-ink-400">
        A populated SynaptoDeck profile — buttons, widgets, mobile remote pairing.
      </p>
    </div>
  </div>
</section>
