---
import { Icon } from 'astro-icon/components';
import type { Feature } from '../lib/features';
import { lucideId } from '../lib/iconName';
import { statusLabel } from '../lib/features';

interface Props {
  feature: Feature;
  compact?: boolean;
}

const { feature, compact = false } = Astro.props;
const iconId = lucideId(feature.icon);
const isPlanned = feature.status === 'planned';
const isBeta = feature.status === 'beta';
const isDeprecated = feature.status === 'deprecated';
const showBadge = isPlanned || isBeta || isDeprecated;
---

<article
  id={feature.id}
  class:list={[
    'card flex h-full flex-col gap-4 p-6 transition hover:bg-white/[0.04]',
    compact && 'p-5',
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <span
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brand-cyan/10 text-brand-cyan ring-1 ring-inset ring-brand-cyan/20"
      aria-hidden="true"
    >
      <Icon name={iconId} class="h-5 w-5" />
    </span>
    {
      showBadge && (
        <span
          class:list={[
            'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset',
            isPlanned && 'bg-brand-cyan/5 text-brand-cyan ring-brand-cyan/30',
            isBeta && 'bg-amber-300/5 text-amber-300 ring-amber-300/30',
            isDeprecated && 'bg-rose-300/5 text-rose-300 ring-rose-300/30',
          ]}
        >
          {statusLabel(feature.status)}
        </span>
      )
    }
  </div>

  <div class="flex-1">
    <h3 class="text-base font-semibold tracking-tightish text-ink-50">{feature.name}</h3>
    <p class="mt-2 text-sm leading-relaxed text-ink-200">{feature.marketingCopy}</p>
  </div>

  {
    !compact && feature.versionIntroduced && (
      <p class="text-xs text-ink-400">Shipped in {feature.versionIntroduced}</p>
    )
  }
  {
    !compact && feature.plannedVersion && isPlanned && (
      <p class="text-xs text-ink-400">Target: {feature.plannedVersion}</p>
    )
  }
</article>
