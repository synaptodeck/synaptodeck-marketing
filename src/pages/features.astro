---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { featuresByCategory } from '../lib/features';

const groups = featuresByCategory().filter((g) => g.items.length > 0);
---

<Base
  title="Features"
  description="Every SynaptoDeck capability — button actions, widgets, AI Builder, Mobile Remote, integrations, safety, and the platform itself."
>
  <section class="container-page pt-20 md:pt-28">
    <SectionHeading
      eyebrow="Feature inventory"
      title="Everything SynaptoDeck does."
      description="One manifest drives the app and this page. When a feature ships, it appears here on the next build."
    />

    <nav aria-label="Feature categories" class="mt-10 flex flex-wrap gap-2">
      {
        groups.map((g) => (
          <a
            href={`#${g.category.id}`}
            class="rounded-full px-3 py-1.5 text-xs font-medium text-ink-200 ring-1 ring-inset ring-white/10 hover:bg-white/[0.04] hover:text-ink-50"
          >
            {g.category.name}
          </a>
        ))
      }
    </nav>
  </section>

  <div class="container-page pb-24 pt-14 md:pb-32 md:pt-20">
    <div class="space-y-20">
      {
        groups.map((group) => (
          <section id={group.category.id} class="scroll-mt-24">
            <header class="flex flex-col gap-2 border-b border-white/5 pb-6">
              <span class="eyebrow">{group.category.name}</span>
              <p class="text-sm text-ink-300">{group.category.tagline}</p>
            </header>
            <div class="mt-8">
              <FeatureGrid features={group.items} columns={3} />
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <section class="border-t border-white/5 bg-ink-900/30">
    <div class="container-page py-16 text-center md:py-20">
      <h2 class="heading-3 text-ink-50">Don't see what you need?</h2>
      <p class="lead mt-3 mx-auto max-w-2xl">
        We're shipping new features every week. Tell us what's missing or what's
        broken — every message lands in the team's inbox.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href="/feedback" class="btn-primary text-base">
          <Icon name="lucide:message-circle" class="h-4 w-4" />
          <span>Send feedback</span>
        </a>
        <a href="/download" class="btn-secondary text-base">
          <span>Or try it free</span>
        </a>
      </div>
    </div>
  </section>
</Base>
